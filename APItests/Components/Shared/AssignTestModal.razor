@inject WorkspaceStore Store
<div class="modal-backdrop" @onclick="Close">
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="assign-title" @onclick:stopPropagation="true">
        <div class="modal-heading">
            <span class="tile-icon violet">
                <Icon Name="users" />
            </span>
            <button class="icon-button" aria-label="Закрыть" @onclick="Close">
                <Icon Name="close" />
            </button>
        </div>
        <h2 id="assign-title">Назначить тест</h2>
        <p class="muted">Выберите коллег и удобный срок прохождения.</p>
        <label class="field-label" for="assign-test">Тест</label>
        <select id="assign-test" @bind="testId">@foreach (var t in Store.Tests) { <option value="@t.Id">@t.Title</option> }</select>
        <label class="field-label" for="assign-deadline">Пройти до</label>
        <input id="assign-deadline" type="date" @bind="deadline" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <div class="field-label selection-label">
            <span>Сотрудники <span class="muted">· выбрано @selected.Count</span>
            </span>
            <button class="text-button" @onclick="SelectAll">@(selected.Count == Store.Employees.Length ? "Снять выбор" : "Выбрать всех")</button>
        </div>
        <div class="employee-picker">@foreach (var e in Store.Employees) { <label class="employee-pick">
                <input type="checkbox" checked="@selected.Contains(e.Id)" @onchange="() => Toggle(e.Id)" />
                <span class="avatar @e.Color">@e.Initials</span>
                <span>
                    <strong>@e.Name</strong>
                    <small>@e.Department</small>
                </span>
            </label> }</div>
        @if (error != null) { <div class="alert alert-error" role="alert">@error</div> }
        <div class="info-note compact">Назначение появится в результатах. В деморежиме письма не отправляются.</div>
        <div class="modal-actions">
            <button class="btn btn-secondary" @onclick="Close">Отмена</button>
            <button class="btn btn-primary" disabled="@(selected.Count == 0)" @onclick="Save">Назначить <Icon Name="arrow" />
            </button>
        </div>
    </section>
</div>
@code {
    [Parameter] public Guid? TestId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnSaved { get; set; }
    private Guid testId;
    private DateTime deadline = DateTime.Today.AddDays(7);
    private readonly HashSet<Guid> selected = [];
    private string? error;
    protected override void OnInitialized() => testId = TestId ?? Store.Tests.First().Id;
    private void Toggle(Guid id) { if (!selected.Add(id)) selected.Remove(id); }
    private void SelectAll() { if (selected.Count == Store.Employees.Length) selected.Clear(); else foreach (var e in Store.Employees) selected.Add(e.Id); }
    private Task Close() => OnClose.InvokeAsync();
    private async Task Save()
    {
        try
        {
            var count = Store.Assign(testId, selected, deadline);
            if (count == 0) { error = "У выбранных сотрудников уже есть незавершённое назначение этого теста."; return; }
            await OnSaved.InvokeAsync(count);
        }
        catch (ArgumentException ex) { error = ex.Message; }
    }
}
