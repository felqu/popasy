@page "/results"
@inject WorkspaceStore Store
@inject IJSRuntime JS
<PageTitle>Результаты — Forma</PageTitle>
<PageHeader Eyebrow="ОТ ДАННЫХ К РАЗВИТИЮ" Title="Результаты команды" Description="Видеть прогресс. Замечать сильные стороны. Помогать расти.">
    <button class="btn btn-secondary" disabled="@(Filtered.Length == 0)" @onclick="Export">
        <Icon Name="download" />Экспорт CSV</button>
    <button class="btn btn-primary" @onclick="() => assignOpen = true">
        <Icon Name="plus" />Назначить тест</button>
</PageHeader>
<section class="metrics-grid result-metrics">
    <div class="metric-card">
        <div class="metric-top">
            <span>Всего назначений</span>
            <span class="metric-icon violet">
                <Icon Name="tests" />
            </span>
        </div>
        <strong class="metric-value">@Filtered.Length</strong>
        <div class="metric-bottom">С учётом выбранных фильтров</div>
    </div>
    <div class="metric-card">
        <div class="metric-top">
            <span>Завершено</span>
            <span class="metric-icon green">
                <Icon Name="check-circle" />
            </span>
        </div>
        <strong class="metric-value">@Completed.Length</strong>
        <div class="metric-bottom">Из @Filtered.Length назначений</div>
    </div>
    <div class="metric-card">
        <div class="metric-top">
            <span>Средний результат</span>
            <span class="metric-icon blue">
                <Icon Name="target" />
            </span>
        </div>
        <strong class="metric-value">@(Completed.Length == 0 ? "—" : Math.Round(Completed.Average(a => a.Score ?? 0)).ToString())<span>%</span>
        </strong>
        <div class="metric-bottom">По завершённым попыткам</div>
    </div>
    <div class="metric-card">
        <div class="metric-top">
            <span>Нужна поддержка</span>
            <span class="metric-icon peach">
                <Icon Name="book" />
            </span>
        </div>
        <strong class="metric-value">@Completed.Count(a => a.Score < Store.FindTest(a.TestId)!.PassScore)</strong>
                <div class="metric-bottom">Результат ниже проходного балла</div>
            </div>
        </section>
        @if (message != null) { <div class="alert alert-success" role="status">
            <Icon Name="check-circle" />@message<button class="icon-button" aria-label="Закрыть" @onclick="() => message = null">
                <Icon Name="close" />
            </button>
        </div> }
        <section class="panel">
            <div class="results-toolbar">
                <div class="segmented-tabs">
                    <button class="@(status == "all" ? "selected" : "")" @onclick='() => status = "all"'>Все назначения</button>
                    <button class="@(status == "completed" ? "selected" : "")" @onclick='() => status = "completed"'>Завершённые</button>
                    <button class="@(status == "pending" ? "selected" : "")" @onclick='() => status = "pending"'>Ожидают</button>
                    <button class="@(status == "overdue" ? "selected" : "")" @onclick='() => status = "overdue"'>Просроченные</button>
                </div>
                <div class="results-filter-row">
                    <div class="input-with-icon search-input">
                        <Icon Name="search" />
                        <input aria-label="Поиск результатов" placeholder="Сотрудник или название теста…" @bind="search" @bind:event="oninput" />
                    </div>
                    <select aria-label="Сотрудник" @bind="employeeFilter">
                        <option value="">Все сотрудники</option>@foreach (var e in Store.Employees) { <option value="@e.Id">@e.Name</option> }</select>
                    <select aria-label="Тест" @bind="testFilter">
                        <option value="">Все тесты</option>@foreach (var t in Store.Tests) { <option value="@t.Id">@t.Title</option> }</select>
                    <select aria-label="Период результатов" @bind="period">
                        <option value="0">За всё время</option>
                        <option value="7">Последние 7 дней</option>
                        <option value="30">Последние 30 дней</option>
                    </select>@if (HasFilters) { <button class="text-button" @onclick="Reset">Сбросить</button> }</div>
            </div>
            @if (Filtered.Length == 0) { <EmptyState Title="Пока нет таких результатов" Description="Измените фильтры или назначьте команде новый тест.">
                <button class="btn btn-secondary" @onclick="Reset">Сбросить фильтры</button>
            </EmptyState> }
            else { <div class="table-scroll">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>СОТРУДНИК</th>
                            <th>ТЕСТ</th>
                            <th>РЕЗУЛЬТАТ</th>
                            <th>СТАТУС</th>
                            <th>ДАТА / СРОК</th>
                            <th>
                            </th>
                        </tr>
                    </thead>
                    <tbody>@foreach (var a in Filtered) { var e = Store.FindEmployee(a.EmployeeId)!; var test = Store.FindTest(a.TestId)!; var expired = a.CompletedAt == null && a.Deadline.Date < DateTime.Today; <tr>
                            <td>
                                <div class="person-cell">
                                    <span class="avatar @e.Color">@e.Initials</span>
                                    <span>
                                        <strong>@e.Name</strong>
                                        <small>@e.Department</small>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <a class="table-test-title" href="/tests/@test.Id">@test.Title</a>
                                <small class="cell-subtext">@test.Questions.Length вопросов · @test.Level</small>
                            </td>
                            <td>@if (a.Score != null) { <span class="score-value @(a.Score >= test.PassScore ? "positive" : "warning-text")">@a.Score<span>%</span>
                                </span> } else { <span class="muted">—</span> }</td>
                            <td>
                                <span class="badge @(a.CompletedAt != null ? a.Score >= test.PassScore ? "badge-success" : "badge-warning" : expired ? "badge-error" : "badge-neutral")">
                                    <span class="status-dot"></span>@(a.CompletedAt != null ? a.Score >= test.PassScore ? "Пройден" : "Нужна практика" : expired ? "Срок истёк" : "Назначен")</span>
                            </td>
                            <td>
                                <span class="table-date">@((a.CompletedAt ?? a.Deadline).ToString("dd.MM.yyyy"))</span>
                                <small class="cell-subtext">@(a.CompletedAt != null ? "Завершён" : "Пройти до")</small>
                            </td>
                            <td>@if (expired) { <button class="text-button" @onclick="() => { assignmentTest = test.Id; assignOpen = true; }">Повторить</button> } else { <a class="text-link" href="/take/@a.Id">@(a.CompletedAt != null ? "Подробнее" : "Пройти")<Icon Name="@(a.CompletedAt != null ? "chevron" : "play")" />
                                </a> }</td>
                        </tr> }</tbody>
                </table>
            </div>
            <div class="table-footer">
                <span>Показано @Filtered.Length из @Store.Assignments.Length назначений</span>
                <span>
                    <span class="status-dot"></span>Результаты обновляются после прохождения</span>
            </div> }</section>
        <div class="results-footnote">
            <Icon Name="help" />
            <span>В деморежиме администратор может пройти тест от имени сотрудника. Реальная система потребует авторизации и разграничения доступа.</span>
        </div>
        @if (assignOpen) { <AssignTestModal TestId="assignmentTest" OnClose="() => { assignOpen = false; assignmentTest = null; }" OnSaved="Assigned" /> }
@code {
    [SupplyParameterFromQuery(Name = "employee")] public Guid? EmployeeId { get; set; }
    [SupplyParameterFromQuery(Name = "test")] public Guid? TestId { get; set; }
    private string search = "", status = "all", employeeFilter = "", testFilter = "";
    private int period;
    private bool assignOpen;
    private Guid? assignmentTest;
    private string? message;
    protected override void OnParametersSet() { employeeFilter = EmployeeId?.ToString() ?? ""; testFilter = TestId?.ToString() ?? ""; }
    private bool HasFilters => search != "" || status != "all" || employeeFilter != "" || testFilter != "" || period != 0;
    private Assignment[] Filtered => Store.Assignments.Where(a =>
        (employeeFilter == "" || a.EmployeeId.ToString() == employeeFilter) && (testFilter == "" || a.TestId.ToString() == testFilter) &&
        (status == "all" || status == "completed" && a.CompletedAt != null || status == "pending" && a.CompletedAt == null && a.Deadline.Date >= DateTime.Today || status == "overdue" && a.CompletedAt == null && a.Deadline.Date < DateTime.Today) &&
        (period == 0 || (a.CompletedAt ?? a.AssignedAt) >= DateTime.Today.AddDays(-period + 1)) &&
        ((Store.FindEmployee(a.EmployeeId)?.Name ?? "") + " " + (Store.FindTest(a.TestId)?.Title ?? "")).Contains(search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(a => a.CompletedAt ?? a.AssignedAt).ToArray();
    private Assignment[] Completed => Filtered.Where(a => a.CompletedAt != null).ToArray();
    private void Reset() { search = employeeFilter = testFilter = ""; status = "all"; period = 0; }
    private void Assigned(int count) { assignOpen = false; assignmentTest = null; message = $"Создано назначений: {count}."; Reset(); }
    private async Task Export()
    {
        static string Cell(string value)
        {
            if (value.TrimStart().FirstOrDefault() is '=' or '+' or '-' or '@') value = "'" + value;
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        }
        var rows = new List<string> { "Сотрудник;Отдел;Тест;Результат (%);Статус;Дата завершения;Срок прохождения" };
        rows.AddRange(Filtered.Select(a => string.Join(";", new[] { Store.FindEmployee(a.EmployeeId)!.Name, Store.FindEmployee(a.EmployeeId)!.Department,
            Store.FindTest(a.TestId)!.Title, a.Score?.ToString() ?? "", a.CompletedAt != null ? a.Score >= Store.FindTest(a.TestId)!.PassScore ? "Пройден" : "Нужна практика" : WorkspaceStore.Status(a),
            a.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "", a.Deadline.ToString("dd.MM.yyyy") }.Select(Cell))));
        await JS.InvokeVoidAsync("forma.downloadCsv", $"forma-results-{DateTime.Today:yyyy-MM-dd}.csv", string.Join("\r\n", rows));
    }
}
